{
  "name": "@gomata/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
